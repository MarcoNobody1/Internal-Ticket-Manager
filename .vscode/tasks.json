{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: run api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/backend/Api/InternalTicketManager.Api.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Now listening on:|Application started\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "runtime"
      }
    },
    {
      "label": "frontend: serve",
      "type": "process",
      "command": "ng",
      "args": [
        "serve",
        "--port",
        "4201",
        "--open",
        "false"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Compiled successfully|Local:\\s+http://localhost:4201/|Application bundle generation complete"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "runtime"
      }
    },
    {
      "label": "app: run full stack",
      "dependsOrder": "parallel",
      "dependsOn": [
        "backend: run api",
        "frontend: serve"
      ]
    }
  ]
}
